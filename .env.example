# Environment Configuration for Skill-aware Chat Runtime

# ===== API Configuration =====

# Option 1: DeepSeek (Recommended for Chinese users)
DEEPSEEK_API_KEY=your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
ROUTER_MODEL=deepseek-chat

# Option 2: OpenAI
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-3.5-turbo
# ROUTER_MODEL=gpt-3.5-turbo

# Option 3: Ollama (Local)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=llama3.2
# ROUTER_MODEL=llama3.2

# ===== Other Options =====

# Enable debug mode (shows full error tracebacks)
# DEBUG=1

